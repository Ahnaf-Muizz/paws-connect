# Copy to .env.local for local development, or run `vercel env pull .env.local`
# after connecting the Neon and Blob integrations in the Vercel dashboard.
# Every variable is optional locally: without them the app runs on an in-memory
# Postgres (PGlite) seeded with demo data, and photos are saved under .data/uploads.

# Neon Postgres connection string (added automatically by the Vercel Neon integration).
DATABASE_URL=

# Secret used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Vercel Blob read/write token (added automatically when you create a Blob store).
BLOB_READ_WRITE_TOKEN=
